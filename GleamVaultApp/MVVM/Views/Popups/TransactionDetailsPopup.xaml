<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="GleamVault.MVVM.Views.Popups.TransactionDetailsPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:GleamVault.Converters"
    xmlns:models="clr-namespace:Shared.Models;assembly=Shared"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Padding="0"
    x:DataType="models:Transaction"
    Background="{StaticResource Brush.CardBgGradient}"
    CanBeDismissedByTappingOutsideOfPopup="True"
    MaximumHeightRequest="800"
    WidthRequest="550">
    <toolkit:Popup.Resources>
        <conv:PriceConverter x:Key="PriceConverter" />
        <conv:FirstCharConverter x:Key="FirstCharConverter" />
        <conv:ChannelConverter x:Key="ChannelConverter" />
        <conv:DateConverter x:Key="DateConverter" />
        <conv:DiscountTextConverter x:Key="DiscountTextConverter" />
        <conv:SubtotalTextConverter x:Key="SubtotalTextConverter" />
        <conv:SkuTextConverter x:Key="SkuTextConverter" />
        <conv:QuantityTextConverter x:Key="QuantityTextConverter" />
        <conv:IsGreaterThanZeroConverter x:Key="IsGreaterThanZeroConverter" />
    </toolkit:Popup.Resources>

    <ScrollView>
        <Grid
            Padding="20"
            RowDefinitions="Auto,*,Auto"
            RowSpacing="0">
            <!--  Header  -->
            <Border
                Grid.Row="0"
                Padding="20,16"
                Background="{StaticResource Brush.HeaderGradient}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border
                        Grid.Column="0"
                        HeightRequest="48"
                        StyleClass="icon-circle"
                        WidthRequest="48">
                        <shapes:Path
                            Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                            Fill="{StaticResource Primary}"
                            HeightRequest="28"
                            WidthRequest="28" />
                    </Border>
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4"
                        VerticalOptions="Center">
                        <Label StyleClass="h3" Text="Transaction Details" />
                        <Label
                            FontFamily="NexaLight"
                            FontSize="12"
                            Text="{Binding Description}"
                            TextColor="{StaticResource TextLight}" />
                    </VerticalStackLayout>
                    <Button
                        x:Name="CloseButton"
                        Grid.Column="2"
                        Background="Transparent"
                        Clicked="CloseButton_Clicked"
                        FontFamily="NexaHeavy"
                        FontSize="18"
                        Text="✕"
                        TextColor="{StaticResource TextDark}" />
                </Grid>
            </Border>

            <!--  Content  -->
            <Grid
                Grid.Row="1"
                Padding="20"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                RowSpacing="20">
                <!--  Transaction Info  -->
                <Border
                    Padding="16"
                    Background="{StaticResource Secondary}"
                    Opacity="0.1"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <shapes:Path
                                Grid.Column="0"
                                Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"
                                Fill="{StaticResource Primary}"
                                HeightRequest="20"
                                WidthRequest="20" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label
                                    FontFamily="NexaLight"
                                    FontSize="11"
                                    Text="Date  Time"
                                    TextColor="{StaticResource TextLight}" />
                                <Label
                                    FontFamily="NexaHeavy"
                                    FontSize="14"
                                    Text="{Binding CreatedAt, Converter={StaticResource DateConverter}}"
                                    TextColor="{StaticResource TextDark}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <shapes:Path
                                Grid.Column="0"
                                Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"
                                Fill="{StaticResource Primary}"
                                HeightRequest="20"
                                WidthRequest="20" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label
                                    FontFamily="NexaLight"
                                    FontSize="11"
                                    Text="Channel"
                                    TextColor="{StaticResource TextLight}" />
                                <Label
                                    FontFamily="NexaHeavy"
                                    FontSize="14"
                                    Text="{Binding Channel, Converter={StaticResource ChannelConverter}}"
                                    TextColor="{StaticResource TextDark}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!--  Customer Info  -->
                <Border
                    Padding="16"
                    Background="{StaticResource Brush.CardBgGradient}"
                    Shadow="{StaticResource Sh.CyanSm}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border
                            Grid.Column="0"
                            Background="{StaticResource Secondary}"
                            HeightRequest="60"
                            StrokeShape="RoundRectangle 30"
                            StrokeThickness="0"
                            WidthRequest="60">
                            <Label
                                FontFamily="NexaHeavy"
                                FontSize="24"
                                HorizontalOptions="Center"
                                Text="{Binding Customer.FullName, Converter={StaticResource FirstCharConverter}}"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="6"
                            VerticalOptions="Center">
                            <Label
                                FontFamily="NexaHeavy"
                                FontSize="16"
                                Text="Customer"
                                TextColor="{StaticResource TextLight}" />
                            <Label
                                FontFamily="NexaHeavy"
                                FontSize="18"
                                Text="{Binding Customer.FullName}"
                                TextColor="{StaticResource TextDark}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!--  Items  -->
                <Border
                    Padding="16"
                    Background="{StaticResource Brush.CardBgGradient}"
                    Shadow="{StaticResource Sh.CyanSm}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            FontFamily="NexaHeavy"
                            FontSize="16"
                            Text="Items"
                            TextColor="{StaticResource TextDark}" />
                        <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TransactionItem">
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="12"
                                        Background="{StaticResource Secondary}"
                                        Opacity="0.1"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0">
                                        <Grid
                                            Padding="8,4"
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="12">
                                            <Border
                                                Grid.Column="0"
                                                Background="{StaticResource Secondary}"
                                                HeightRequest="50"
                                                StrokeShape="RoundRectangle 10"
                                                StrokeThickness="0"
                                                WidthRequest="50">
                                                <Image Aspect="AspectFill" Source="{Binding ImageUrl}" />
                                            </Border>
                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="4"
                                                VerticalOptions="Center">
                                                <Label
                                                    FontFamily="NexaHeavy"
                                                    FontSize="14"
                                                    Text="{Binding Name}"
                                                    TextColor="{StaticResource TextDark}" />
                                                <Label
                                                    FontFamily="NexaLight"
                                                    FontSize="11"
                                                    Text="{Binding Sku, Converter={StaticResource SkuTextConverter}}"
                                                    TextColor="{StaticResource TextLight}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout
                                                Grid.Column="2"
                                                HorizontalOptions="End"
                                                Spacing="4"
                                                VerticalOptions="Center">
                                                <Label
                                                    FontFamily="NexaHeavy"
                                                    FontSize="14"
                                                    HorizontalTextAlignment="End"
                                                    Text="{Binding Quantity, Converter={StaticResource QuantityTextConverter}}"
                                                    TextColor="{StaticResource TextDark}" />
                                                <Label
                                                    FontFamily="NexaLight"
                                                    FontSize="12"
                                                    HorizontalTextAlignment="End"
                                                    Text="{Binding UnitPrice, Converter={StaticResource PriceConverter}}"
                                                    TextColor="{StaticResource TextLight}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!--  Summary  -->
                <Border
                    Padding="16"
                    Background="{StaticResource Brush.CardBgGradient}"
                    Shadow="{StaticResource Sh.CyanSm}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            FontFamily="NexaHeavy"
                            FontSize="16"
                            Text="Summary"
                            TextColor="{StaticResource TextDark}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="8">
                                <Label
                                    FontFamily="NexaLight"
                                    FontSize="14"
                                    Text="{Binding SubTotalAmount, Converter={StaticResource SubtotalTextConverter}}"
                                    TextColor="{StaticResource TextLight}" />
                                <Label
                                    FontFamily="NexaLight"
                                    FontSize="14"
                                    IsVisible="{Binding DiscountValue, Converter={StaticResource IsGreaterThanZeroConverter}}"
                                    Text="{Binding DiscountValue, Converter={StaticResource DiscountTextConverter}}"
                                    TextColor="Red" />
                            </VerticalStackLayout>
                            <Border
                                Grid.Column="1"
                                Padding="16,12"
                                Background="{StaticResource Primary}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Label
                                    FontFamily="NexaHeavy"
                                    FontSize="20"
                                    Text="{Binding TotalAmount, Converter={StaticResource PriceConverter}}"
                                    TextColor="White" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ScrollView>
</toolkit:Popup>

